modules = ["nodejs-20"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Socket Server"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd trendspy-backend && npm run dev"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Socket Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd trendspy-backend && node socket-server.js"
waitForPort = 3002

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5002
externalPort = 3002

[[ports]]
localPort = 5003
externalPort = 3003

[deployment]
deploymentTarget = "static"
build = ["npm", "run", "build"]
publicDir = "dist"

[userenv]

[userenv.shared]
DB_NAME = "trendspy"
NODE_ENV = "development"
BACKEND_PORT = "3001"
JWT_EXPIRES_IN = "7d"
CRON_ENABLED = "true"
SOCKET_PORT = "3002"
SOCKET_INTERNAL_URL = "http://localhost:3002"
SOCKET_INTERNAL_SECRET = "trendspy-socket-internal-secret-2025"
JWT_SECRET = "1e455f0322ccc642ea4c204af028b90e44010e8bf7877e49592beec4a66c980d4026da14e68592685d8c3d95d0fb47d7"
ADMIN_API_KEY = "c41fc07d6ef74eb1503566ab474a87565697013fe3da106f2e534cacfbdd6674"
CONFIDENCE_THRESHOLD = "60"
AUTO_CORRECT_ENABLED = "true"
SEASONAL_FILTERING = "true"
AUTO_SCRAPER_ENABLED = "true"
EMAIL_USER = "your_gmail@gmail.com"
EMAIL_PASS = "your_gmail_app_password"
TIKTOK_RAPIDAPI_KEY = "your_rapidapi_key_here"
TIKTOK_API_HOST = "tiktok-scraper7.p.rapidapi.com"

[userenv.development]
FRONTEND_URL = "http://localhost:5000"

[userenv.production]
FRONTEND_URL = "https://trendspy.replit.app"
