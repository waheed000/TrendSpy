modules = ["nodejs-20", "web", "nix"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Socket Server"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd trendspy-backend && npm run dev"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Socket Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd trendspy-backend && node socket-server.js"
waitForPort = 3002

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5002
externalPort = 3002

[[ports]]
localPort = 5003
externalPort = 3003

[deployment]
deploymentTarget = "static"
build = ["npm", "run", "build"]
publicDir = "dist"

[userenv]

[userenv.shared]
DB_NAME = "trendspy"
NODE_ENV = "development"
BACKEND_PORT = "3001"
JWT_EXPIRES_IN = "7d"
CRON_ENABLED = "true"
SOCKET_PORT = "3002"
SOCKET_INTERNAL_URL = "http://localhost:3002"
CONFIDENCE_THRESHOLD = "60"
AUTO_CORRECT_ENABLED = "true"
SEASONAL_FILTERING = "true"
AUTO_SCRAPER_ENABLED = "true"
TIKTOK_API_HOST = "tiktok-scraper7.p.rapidapi.com"
SOCKET_INTERNAL_SECRET = "trendspy-socket-internal-secret-2025"

[userenv.development]
FRONTEND_URL = "http://localhost:5000"

[userenv.production]
FRONTEND_URL = "https://trendspy.replit.app"
