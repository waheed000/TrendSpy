# ─────────────────────────────────────────────────────────
# TrendSpy Backend — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# On Replit, set these in the Secrets panel (not in code).
# ─────────────────────────────────────────────────────────

# ── Auth (required) ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars

# ── Database ──────────────────────────────────────────────
# Leave blank in dev to use auto in-memory MongoDB (resets on restart).
# Set to a MongoDB Atlas URI for persistent data.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/trendspy

# Name of the MongoDB database to use
DB_NAME=trendspy

# ── AI Analysis (optional) ────────────────────────────────
# Get a free key at https://console.groq.com
# Without this key, the AI analyst uses a local rule-based fallback (no crash).
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Facebook Ad Spy (optional) ────────────────────────────
# Required only for live Facebook Ad Library scraping.
# Without this, the app serves seeded/cached ads (no crash).
# Format: c_user=<value>; xs=<value>
FB_SESSION_COOKIE=c_user=123456789; xs=abc123def456

# ── Admin API Key (required for admin routes) ─────────────
# Protects /api/admin/* and supplier management routes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=your_admin_api_key_here

# ── Server Ports (defaults shown — change only if needed) ─
BACKEND_PORT=3001
SOCKET_PORT=3002
NODE_ENV=development

# ── Frontend URL ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5000

# ── Socket Internal Secret ────────────────────────────────
# Shared secret between Next.js backend and the socket server.
SOCKET_INTERNAL_SECRET=trendspy-socket-internal-secret-2025
SOCKET_INTERNAL_URL=http://localhost:3002

# ── TikTok API (optional) ────────────────────────────────
# Set TIKTOK_SANDBOX_MODE=true to use mock data without a real key.
TIKTOK_API_HOST=tiktok-scraper7.p.rapidapi.com
TIKTOK_API_KEY=your_rapidapi_key_here
TIKTOK_SANDBOX_MODE=true

# ── Email Notifications (optional) ───────────────────────
# Required only for email alert delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ── Chromium Path (auto-detected on Replit) ───────────────
# CHROMIUM_PATH=/nix/store/.../bin/chromium

# ── Feature Flags ─────────────────────────────────────────
CRON_ENABLED=true
AUTO_SCRAPER_ENABLED=true
TIKTOK_SANDBOX_MODE=true
CONFIDENCE_THRESHOLD=60
AUTO_CORRECT_ENABLED=true
SEASONAL_FILTERING=true
