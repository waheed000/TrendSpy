# ═══════════════════════════════════════════════════════════════════
#  TrendSpy — Environment Variables Reference
#  Copy this file to .env.local and fill in your actual values.
#  NEVER commit .env.local — it is in .gitignore.
#  Real values must be stored in Replit Secrets (not this file).
# ═══════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────
# MongoDB Atlas connection string (primary — data persists on restart)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name (default: trendspy)
DB_NAME=trendspy

# ── Auth ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_64_char_hex_secret_here
JWT_EXPIRES_IN=7d

# ── Admin ───────────────────────────────────────────────────────────
# Strong random string for admin API key
ADMIN_API_KEY=your_admin_api_key_here

# ── Email (Nodemailer via Gmail) ────────────────────────────────────
EMAIL_USER=your_gmail@gmail.com
# Gmail App Password (not your regular password — create at myaccount.google.com/apppasswords)
EMAIL_PASS=your_gmail_app_password_here

# ── Facebook Ad Library Scraping ────────────────────────────────────
# Your Facebook session cookie (c_user=...; xs=...)
FB_SESSION_COOKIE=c_user=YOUR_C_USER; xs=YOUR_XS_TOKEN

# ── TikTok (RapidAPI) ───────────────────────────────────────────────
TIKTOK_RAPIDAPI_KEY=your_rapidapi_key_here
TIKTOK_API_HOST=tiktok-scraper7.p.rapidapi.com

# ── AI / LLM ────────────────────────────────────────────────────────
# Get from: console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Feature Flags ───────────────────────────────────────────────────
AUTO_SCRAPER_ENABLED=true
SEASONAL_FILTERING=true
CONFIDENCE_THRESHOLD=60
AUTO_CORRECT_ENABLED=true

# ── Server Ports ────────────────────────────────────────────────────
BACKEND_PORT=3001
SOCKET_PORT=3002

# ── Internal Communication ───────────────────────────────────────────
SOCKET_INTERNAL_URL=http://localhost:3002
SOCKET_INTERNAL_SECRET=trendspy-socket-internal-secret-2025

# ── Frontend URLs ───────────────────────────────────────────────────
# Development
FRONTEND_URL=http://localhost:5000
# Production (update after deploying)
# FRONTEND_URL=https://your-app.replit.app
